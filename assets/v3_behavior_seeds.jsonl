{"id": "v3-behavior-collapse-stable", "case_id": "v3-behavior-collapse", "task": "symptom_collection", "source": "author_created_v3_behavior_seed", "origin": "authored_behavior", "review_status": "unreviewed", "behavior_version": "v3-behavior-v1", "behavior_checks": {"required": [], "forbidden": []}, "messages": [{"role": "user", "content": "今天身体有点乏力，家人帮我问一下该怎么描述。"}, {"role": "assistant", "content": "患者年龄、开始时间和活动影响怎样？目前是否清醒，是否有胸痛、明显呼吸困难或晕倒？"}, {"role": "user", "content": "家人五十多岁，今天开始乏力，刚才清醒，能正常说话走路，没有晕倒。"}, {"role": "assistant", "content": "记录患者本人的年龄、病程和活动影响，不把咨询者的信息替代进去。若持续不适可安排面诊；出现晕倒或意识异常等新变化需要立即重评。"}, {"role": "user", "content": "休息后乏力减轻，人清醒、说话走路正常，给医生的记录如何写？"}, {"role": "assistant", "content": "可以写今天开始乏力，休息后减轻，目前清醒并能正常说话走路；保留仍未核实的具体年龄等字段。记录帮助描述变化，不代表原因已经明确，反复或影响生活时安排评估。"}]}
